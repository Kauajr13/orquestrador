# Copie para .env.local e preencha. Sem isto o painel roda em modo demonstração.

# Supabase — crie o projeto na região São Paulo (importa para a LGPD: assim os
# e-mails dos leads não saem do país)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Só para rodar migration: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Quem pode abrir o painel. Lista separada por vírgula.
EMAILS_PERMITIDOS=

# LLM — gateway compatível com a API de chat da OpenAI.
# Trocar de provedor quando a promoção acabar é mudar estas três linhas.
BAI_API_KEY=
BAI_BASE_URL=https://api.b.ai/v1
# Modelo grande: código e decisão estratégica
BAI_MODELO_CARO=
# Modelo pequeno: classificar, resumir, escrever conteúdo
BAI_MODELO_BARATO=

# GitHub — PAT fine-grained com acesso a ESTE repositório apenas,
# permissões Contents e Pull requests em modo write.
GITHUB_TOKEN=
GITHUB_REPO=Escala-1-para-1/orquestrador

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Qualquer string longa e aleatória; vai também no setWebhook
TELEGRAM_WEBHOOK_SECRET=

# Busca na web (free tier em tavily.com)
TAVILY_API_KEY=

# Protege a rota do cron. Gere com: openssl rand -hex 32
CRON_SECRET=

# Endereço público, usado no sitemap e no robots
NEXT_PUBLIC_URL_SITE=https://orq.escala1para1.com.br
