# Copie para .env.local e preencha. Sem isto o painel roda em modo demonstração.

# ------------------------------------------------------------------ Supabase
# Crie o projeto na região São Paulo — importa para a LGPD: assim o e-mail dos
# leads não sai do país. As chaves ficam em Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (sb_publishable_...), o que antes se chamava "anon"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...), o que antes se chamava "service_role".
# Ignora RLS: só o servidor usa, nunca o navegador.
SUPABASE_SECRET_KEY=

# Só para `npm run db:migrate`: https://supabase.com/dashboard/account/tokens
# Alternativa sem token: aplicar o SQL direto com psql, usando a senha do banco.
#   psql "postgresql://postgres@db.<ref>.supabase.co:5432/postgres" -f supabase/schema.sql
SUPABASE_ACCESS_TOKEN=

# Quem pode abrir o painel. Lista separada por vírgula.
EMAILS_PERMITIDOS=

# ----------------------------------------------------------------------- LLM
# Qualquer provedor que fale /chat/completions no formato da OpenAI E suporte
# tool calling. Sem tool calling o runner não funciona — é assim que o agente
# pede para usar uma ferramenta.
#
#   Mistral    https://api.mistral.ai/v1
#              caro: mistral-large-latest    barato: mistral-small-latest
#              1 bilhão de tokens/mês no free tier
#
#   Gemini     https://generativelanguage.googleapis.com/v1beta/openai
#              sem cartão e sem expiração, mas ~20 requisições por DIA em cada
#              modelo. Por isso as variáveis aceitam lista: quando um modelo
#              esgota, o próximo assume, e as cotas se somam. Medido na prática:
#              caro:   gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.6-flash
#              barato: gemini-3.1-flash-lite,gemini-flash-lite-latest
#
#   Groq       https://api.groq.com/openai/v1
#              caro: llama-3.3-70b-versatile
#
#   DeepSeek   https://api.deepseek.com/v1
#              caro: deepseek-chat           barato: deepseek-chat
#              pago, ~US$ 0,28 por milhão de tokens, e não treina com seus dados
#
# Atenção: nos free tiers os seus dados costumam alimentar o treino do modelo.
# Este agente lê e escreve o código de um repositório privado.
LLM_BASE_URL=
LLM_API_KEY=
# Aceitam lista separada por vírgula. A fila é percorrida quando um modelo
# esgota a cota do dia — essencial em free tier, irrelevante em provedor pago.
LLM_MODELO_CARO=
LLM_MODELO_BARATO=

# -------------------------------------------------------------------- GitHub
# PAT fine-grained com acesso a ESTE repositório apenas,
# permissões Contents e Pull requests em modo write.
GITHUB_TOKEN=
GITHUB_REPO=Escala-1-para-1/orquestrador

# ------------------------------------------------------------------ Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Qualquer string longa e aleatória; vai também no setWebhook
TELEGRAM_WEBHOOK_SECRET=

# --------------------------------------------------------------------- resto
# Busca na web (free tier em tavily.com)
TAVILY_API_KEY=

# Protege a rota do cron. Gere com: openssl rand -hex 32
CRON_SECRET=

# Endereço público, usado no sitemap e no robots
NEXT_PUBLIC_URL_SITE=https://orq.escala1para1.com
