# Copie para .env.local e preencha. Sem isto o painel roda em modo demonstração.

# ------------------------------------------------------------------ Supabase
# Crie o projeto na região São Paulo — importa para a LGPD: assim o e-mail dos
# leads não sai do país. As chaves ficam em Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública (sb_publishable_...), o que antes se chamava "anon"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...), o que antes se chamava "service_role".
# Ignora RLS: só o servidor usa, nunca o navegador.
SUPABASE_SECRET_KEY=

# Só para `npm run db:migrate`: https://supabase.com/dashboard/account/tokens
# Alternativa sem token: aplicar o SQL direto com psql, usando a senha do banco.
#   psql "postgresql://postgres@db.<ref>.supabase.co:5432/postgres" -f supabase/schema.sql
SUPABASE_ACCESS_TOKEN=

# Quem pode abrir o painel. Lista separada por vírgula.
EMAILS_PERMITIDOS=

# ----------------------------------------------------------------------- LLM
# Fila de provedores, tentados em ordem. O primeiro é o mais barato; os
# seguintes só entram quando o anterior recusa por cota. Na prática: trabalha
# de graça enquanto der e paga só o excedente.
#
# Numere a partir de 1, sem pular. Provedor sem chave é ignorado, então dá para
# deixar o pago preparado e só preencher quando precisar.
#
# Dois requisitos: falar /chat/completions no formato da OpenAI E suportar tool
# calling. Sem tool calling o runner não funciona.

# 1 — Groq, gratuito. Corta requisição acima de 8 mil tokens por minuto EM CADA
# modelo, por isso a lista: quando um esgota, o próximo assume.
# Sem tool calling, não use: qwen3.6-27b e groq/compound.
LLM_1_URL=https://api.groq.com/openai/v1
LLM_1_KEY=
LLM_1_MODELOS_CARO=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
LLM_1_MODELOS_BARATO=openai/gpt-oss-20b,qwen/qwen3.8-27b

# 2 — Cerebras, também gratuito, e aqui pela razão certa: aceita 30 mil tokens
# por minuto contra os 8 mil do Groq. Ele não soma cota, ele remove o teto — a
# requisição grande que o Groq recusa inteira é a que passa aqui. Oferece os
# mesmos dois modelos que já usamos, então não há prompt a reajustar.
# Gasto atual da empresa: ~161 mil tokens/dia contra o 1 milhão que ele dá.
# Antes de confiar: confirme tool calling no free tier — sem isso o runner não
# funciona, e a documentação de limites não diz.
LLM_2_URL=https://api.cerebras.ai/v1
LLM_2_KEY=
LLM_2_MODELOS_CARO=gpt-oss-120b,qwen-3.8-27b
LLM_2_MODELOS_BARATO=qwen-3.8-27b

# 3 — DeepSeek, pago e sem teto por minuto. Cache de prompt derruba a entrada
# repetida para US$ 0,007 por milhão, e quase todo o nosso prompt se repete.
# Último da fila de propósito: só entra quando os dois gratuitos recusaram.
LLM_3_URL=https://api.deepseek.com/v1
LLM_3_KEY=
LLM_3_MODELOS_CARO=deepseek-chat
LLM_3_MODELOS_BARATO=deepseek-chat

# Descartado: Gemini. Medimos ~20 requisições por DIA em cada modelo, lendo o
# `quotaId` do próprio 429 — não cobre nem um turno de trabalho. Somar um
# provedor que recusa quase sempre só acrescenta uma ida e volta perdida antes
# do próximo da fila.
#
# Outra opção compatível: Mistral, https://api.mistral.ai/v1
#
# Atenção: em free tier, seus dados costumam alimentar o treino do modelo.
# Este agente lê e escreve o código de um repositório privado.

# -------------------------------------------------------------------- GitHub
# PAT fine-grained com acesso a ESTE repositório apenas,
# permissões Contents e Pull requests em modo write.
GITHUB_TOKEN=
GITHUB_REPO=Kauajr13/orquestrador

# ------------------------------------------------------------------ Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Qualquer string longa e aleatória; vai também no setWebhook
TELEGRAM_WEBHOOK_SECRET=

# --------------------------------------------------------------------- resto
# Busca na web (free tier em tavily.com)
TAVILY_API_KEY=

# Protege a rota do cron. Gere com: openssl rand -hex 32
CRON_SECRET=

# Endereço público, usado no sitemap e no robots
NEXT_PUBLIC_URL_SITE=https://orq.escala1para1.com
